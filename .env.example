# Copy to .env.local and replace these placeholders before using each service.
# Keep real credentials in ignored environment files or Vercel settings.
# Contact form: use a sender on a domain verified in Resend.
RESEND_API_KEY=replace-with-your-resend-api-key
CONTACT_FROM_EMAIL=Airshow Events <contact@example.com>
CONTACT_TO_EMAIL=inbox@example.com

# Local programme extraction through AI Gateway. Deployments use their OIDC token;
# locally, `vercel env pull .env.local` provides VERCEL_OIDC_TOKEN instead of a key.
# AI_GATEWAY_API_KEY=replace-with-your-ai-gateway-key
# MONITOR_MODEL=google/gemini-2.5-flash

# Hosted collection: configure these in Vercel Production.
CRON_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=replace-with-your-private-vercel-blob-token

# Spend alerts to Discord: a Discord channel webhook URL, and the secret Vercel shows
# when the Spend Management webhook https://airshow.events/api/spend-alert/ is saved.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-your-webhook
SPEND_WEBHOOK_SECRET=replace-with-the-secret-from-spend-management
