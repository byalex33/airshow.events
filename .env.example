# Copy to .env.local and replace these placeholders before using each service.
# Keep real credentials in ignored environment files or Vercel settings.
# Contact form: use a sender on a domain verified in Resend.
RESEND_API_KEY=replace-with-your-resend-api-key
CONTACT_FROM_EMAIL=Airshow Events <contact@example.com>
CONTACT_TO_EMAIL=inbox@example.com

# Local and hosted source collection.
FIRECRAWL_API_KEY=replace-with-your-firecrawl-api-key

# Hosted collection: configure these in Vercel Production.
CRON_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=replace-with-your-private-vercel-blob-token
